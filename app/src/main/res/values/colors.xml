<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 冷启动时系统先画窗口背景、Compose 首帧要 4~5 秒才出来。
         这段时间原本是一片没有任何信息的浅色空窗，测试者直接理解成死机。 -->
    <color name="launch_background">#F1F5FA</color>

    <!-- 自适应图标底色。
         图标已从「瓶中星」换成语音气泡小吉祥物（仓库根目录的 logo.png）。它自带深蓝描边、
         本体是青蓝渐变，放在原来的浅蓝底上顶部的青色会糊进背景；换纯白底后气泡轮廓、
         眼睛和腮红都能读出来。 -->
    <color name="ic_launcher_background">#FFFFFF</color>
</resources>
