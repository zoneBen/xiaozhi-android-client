<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标。背景是纯白（见 values/colors.xml 的说明），前景是语音气泡小吉祥物的位图，
     已按自适应图标安全区缩放：内容长边占画布 66/108，正好内切于官方安全圆，
     圆形遮罩下左右两条声波不会被切掉（渲染预览核对过）。
     前景位图在 mipmap-{mdpi,hdpi,xhdpi,xxhdpi,xxxhdpi}/ic_launcher_foreground.png。

     注：minSdk=26，Android 8.0 起全部支持自适应图标，
     所以这里不需要再放传统的正方形 ic_launcher.png。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
