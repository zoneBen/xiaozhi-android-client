<?xml version="1.0" encoding="utf-8"?>
<!--
  头屏动画的帧序列本体（气泡呼吸 + 声波扩散），8 帧 × 165ms ≈ 1.32s 一轮。
  动画按「相位」生成，首尾自然衔接，可以无缝循环。

  帧素材在 res/drawable-xxhdpi/splash_*.png（660px = 220dp）。只放一个密度：
  启动图里没有细文字，其他密度交给系统缩放看不出来，省掉四套重复素材。

  这个文件同时被两处用：
  ① SplashActivity 的 ImageView——真正在跑的那份动画；
  ② splash_animation.xml 里的窗口背景——SplashActivity 首个 View 画出来之前，
     以及直接启动 MainActivity 时，系统启动窗口那张静态兜底图。
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item android:drawable="@drawable/splash_00" android:duration="165" />
    <item android:drawable="@drawable/splash_01" android:duration="165" />
    <item android:drawable="@drawable/splash_02" android:duration="165" />
    <item android:drawable="@drawable/splash_03" android:duration="165" />
    <item android:drawable="@drawable/splash_04" android:duration="165" />
    <item android:drawable="@drawable/splash_05" android:duration="165" />
    <item android:drawable="@drawable/splash_06" android:duration="165" />
    <item android:drawable="@drawable/splash_07" android:duration="165" />
</animation-list>
